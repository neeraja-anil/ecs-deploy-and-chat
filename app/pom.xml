<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build file: tells Maven which libraries to download and how to build the app.
  Run `mvn package` to produce target/app.jar (a single runnable file).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Inherit sensible defaults (library versions, plugin config) from Spring Boot -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.healthcheck</groupId>
    <artifactId>app</artifactId>
    <version>1.0.0</version>
    <name>app</name>
    <description>Small web service with a /health endpoint</description>

    <properties>
        <java.version>17</java.version>
    </properties>

    <dependencies>
        <!-- Web server (embedded Tomcat) + REST controllers + JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Testing tools (JUnit, MockMvc); only used by `mvn test`, not shipped -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Name the output target/app.jar instead of target/app-1.0.0.jar (simpler Dockerfile) -->
        <finalName>app</finalName>
        <plugins>
            <!-- Packages everything into one runnable jar: `java -jar target/app.jar` -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
