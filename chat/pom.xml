<?xml version="1.0" encoding="UTF-8"?>
<!--
  Chat interface: a web page + backend that turns plain-text requests into
  changes on the running ECS service. Runs locally: `mvn spring-boot:run`.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.healthcheck</groupId>
    <artifactId>chat</artifactId>
    <version>1.0.0</version>
    <name>chat</name>
    <description>Chat interface that changes the running ECS service</description>

    <properties>
        <java.version>17</java.version>
        <openai.version>4.101.0</openai.version>
        <awssdk.version>2.57.10</awssdk.version>
    </properties>

    <!-- AWS SDK "bill of materials": keeps all AWS modules on the same version -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web server, REST controller, serves the HTML page from src/main/resources/static -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- OpenAI API client: turns the user's text into a structured action -->
        <dependency>
            <groupId>com.openai</groupId>
            <artifactId>openai-java</artifactId>
            <version>${openai.version}</version>
        </dependency>

        <!-- AWS SDK v2: ECS (change the service) and ECR (check an image tag exists) -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ecs</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>ecr</artifactId>
        </dependency>
        <!-- Lets the SDK read credentials created by `aws login` -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>signin</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>chat</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
